{
  "name": "rea-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bun --tsconfig-override tsconfig.app.json scripts/generate-static-routes.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint src functions",
    "check:static": "bun scripts/check-static-routes.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:browser": "node scripts/verify-browser.mjs",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run check:static && bun run check:bundle"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "lucide-react": "^1.34.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.94.0",
    "playwright-core": "^1.65.1",
    "turndown": "^7.2.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
